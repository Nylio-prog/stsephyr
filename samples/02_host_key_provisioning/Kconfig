mainmenu "STSAFE-A120 host-key provisioning example"

config SAMPLE_STSAFE_ALLOW_HOST_KEY_PROVISIONING
	bool "Allow persistent host-key provisioning"
	default n
	help
	  DANGEROUS: writes the host MAC and cipher keys used to authenticate and
	  encrypt host sessions. Incorrect keys can make protected commands
	  unusable. The example never changes provisioning control fields.

config SAMPLE_STSAFE_HOST_MAC_KEY_HEX
	string "AES-128 host MAC key as exactly 32 hexadecimal characters"
	default ""

config SAMPLE_STSAFE_HOST_CIPHER_KEY_HEX
	string "AES-128 host cipher key as exactly 32 hexadecimal characters"
	default ""

choice SAMPLE_STSAFE_HOST_KEY_METHOD
	prompt "Host-key provisioning method"
	default SAMPLE_STSAFE_HOST_KEY_PLAINTEXT

config SAMPLE_STSAFE_HOST_KEY_PLAINTEXT
	bool "Plaintext provisioning"

config SAMPLE_STSAFE_HOST_KEY_WRAPPED
	bool "NIST P-256 wrapped provisioning"
	select STSEPHYR_ECC_NIST_P256
	select STSEPHYR_HOST_SESSION
	select STSEPHYR_HOST_KEY_WRAPPED_PROVISIONING

endchoice

source "Kconfig.zephyr"
