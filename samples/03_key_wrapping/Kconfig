mainmenu "STSAFE-A120 local-envelope wrapping example"

config SAMPLE_STSAFE_ENABLE_KEY_WRAPPING
	bool "Enable local-envelope wrap/unwrap"
	default n

config SAMPLE_STSAFE_ALLOW_WRAP_KEY_GENERATION
	bool "Allow persistent local-envelope key generation"
	default n
	help
	  DANGEROUS: generates or replaces the AES wrapping key in the selected
	  slot. Keep disabled when exercising an already-provisioned wrap key.

config SAMPLE_STSAFE_WRAP_KEY_SLOT
	int "Local-envelope key slot"
	default 0
	range 0 255

config SAMPLE_STSAFE_HOST_MAC_KEY_HEX
	string "Provisioned AES-128 host MAC key as 32 hexadecimal characters"
	default ""

config SAMPLE_STSAFE_HOST_CIPHER_KEY_HEX
	string "Provisioned AES-128 host cipher key as 32 hexadecimal characters"
	default ""

source "Kconfig.zephyr"
