mainmenu "STSAFE-A120 key-pair generation example"

config SAMPLE_STSAFE_ALLOW_KEY_PAIR_GENERATION
	bool "Allow persistent asymmetric key-pair generation"
	default n
	help
	  DANGEROUS: generating a key pair replaces the selected private-key slot
	  and configures its usage limit. Keep this disabled unless the target slot
	  is explicitly available for destructive testing.

config SAMPLE_STSAFE_KEY_SLOT
	int "Asymmetric private-key slot"
	default 1
	range 1 4

config SAMPLE_STSAFE_KEY_USAGE_LIMIT
	int "Generated private-key usage limit"
	default 255
	range 1 255
	help
	  Each signature consumes one use when the slot is configured with a
	  finite usage limit.

choice SAMPLE_STSAFE_KEY_CURVE
	prompt "Generated key curve"
	default SAMPLE_STSAFE_KEY_CURVE_NIST_P256

config SAMPLE_STSAFE_KEY_CURVE_NIST_P256
	bool "NIST P-256"
	select STSEPHYR_ECC_NIST_P256

config SAMPLE_STSAFE_KEY_CURVE_NIST_P521
	bool "NIST P-521"
	select STSEPHYR_ECC_NIST_P521

config SAMPLE_STSAFE_KEY_CURVE_BRAINPOOL_P512
	bool "Brainpool P-512"
	select STSEPHYR_ECC_BRAINPOOL_P512

endchoice

source "Kconfig.zephyr"
