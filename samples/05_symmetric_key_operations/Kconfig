mainmenu "STSAFE-A120 symmetric-key operation example"

config SAMPLE_STSAFE_ALLOW_SYMMETRIC_KEY_WRITE
	bool "Allow persistent symmetric-key slot replacement"
	default n
	help
	  DANGEROUS: every mode writes or establishes a new key in the selected
	  symmetric-key slot before exercising it. Existing key material and slot
	  metadata are replaced.

config SAMPLE_STSAFE_SYMMETRIC_KEY_SLOT
	int "Symmetric-key slot"
	default 0
	range 0 255

config SAMPLE_STSAFE_HOST_MAC_KEY_HEX
	string "Provisioned AES-128 host MAC key as 32 hexadecimal characters"
	default ""

config SAMPLE_STSAFE_HOST_CIPHER_KEY_HEX
	string "Provisioned AES-128 host cipher key as 32 hexadecimal characters"
	default ""

choice SAMPLE_STSAFE_SYMMETRIC_OPERATION
	prompt "Provisioning and operation mode"
	default SAMPLE_STSAFE_SYMMETRIC_ESTABLISH_CMAC

config SAMPLE_STSAFE_SYMMETRIC_ESTABLISH_CMAC
	bool "ECDHE establish AES-128 CMAC key"
	select STSEPHYR_ECC_NIST_P256
	select STSEPHYR_HOST_SESSION
	select STSEPHYR_SYMMETRIC_KEY_ESTABLISHMENT

config SAMPLE_STSAFE_SYMMETRIC_ESTABLISH_CCM
	bool "ECDHE establish AES-256 CCM key"
	select STSEPHYR_ECC_NIST_P256
	select STSEPHYR_HOST_SESSION
	select STSEPHYR_SYMMETRIC_KEY_ESTABLISHMENT

config SAMPLE_STSAFE_SYMMETRIC_WRAPPED_CMAC
	bool "Wrapped provision AES-128 CMAC key"
	select STSEPHYR_ECC_NIST_P256
	select STSEPHYR_HOST_SESSION
	select STSEPHYR_SYMMETRIC_KEY_WRAPPED_PROVISIONING

config SAMPLE_STSAFE_SYMMETRIC_WRAPPED_CCM
	bool "Wrapped provision AES-256 CCM key"
	select STSEPHYR_ECC_NIST_P256
	select STSEPHYR_HOST_SESSION
	select STSEPHYR_SYMMETRIC_KEY_WRAPPED_PROVISIONING

endchoice

source "Kconfig.zephyr"
