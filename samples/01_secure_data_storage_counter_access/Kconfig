mainmenu "STSAFE-A120 counter-zone example"

config SAMPLE_STSAFE_COUNTER_ZONE
	int "Counter-zone index"
	default 5
	range 0 255
	help
	  Zone 5 matches the STSAFE-A120 SPL05 default personalization.

config SAMPLE_STSAFE_ALLOW_COUNTER_DECREMENT
	bool "Allow the example to decrement the one-way counter"
	default n
	help
	  DANGEROUS: each run permanently consumes counter state. Keep this off for
	  normal builds and hardware validation.

source "Kconfig.zephyr"
